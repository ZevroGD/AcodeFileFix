@@ -382,6 +382,12 @@
 export default function actions(action, value) {
 	setQuicktoolsUsed();
 
+	// The paste quick tool targets the code editor; in a terminal tab it has to
+	// go to the terminal instead (and must not take focus away from it).
+	if (action === "command" && value === "paste" && getActiveTerminalComponent()) {
+		return pasteIntoTerminal();
+	}
+
 	const { editor } = editorManager;
 	const { $input, $replaceInput } = quickTools;
 	const routed = quickToolsAdapters.has() && adapterAction(action, value);
@@ -1145,6 +1151,16 @@
 	return getActiveTerminalComponent()?.terminal?.textarea || null;
 }
 
+function pasteIntoTerminal() {
+	const clipboard = globalThis.cordova?.plugins?.clipboard;
+	if (!clipboard) return false;
+	clipboard.paste(
+		(text) => insertText(text),
+		(error) => console.error("Failed to read clipboard", error),
+	);
+	return true;
+}
+
 function insertText(value) {
 	const text = String(value ?? "");
 	if (!text) return false;
