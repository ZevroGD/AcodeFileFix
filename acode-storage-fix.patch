+    /**
+     * Deletes a file or a directory tree. File.delete() alone only removes
+     * empty directories, which made every non-empty folder undeletable from
+     * file managers. Symlinks are unlinked, never followed.
+     */
+    private static boolean deleteRecursive(File file) {
+        boolean isLink = Files.isSymbolicLink(file.toPath());
+        if (!isLink && file.isDirectory()) {
+            File[] children = file.listFiles();
+            if (children != null) {
+                for (File child : children) {
+                    deleteRecursive(child);
+                }
+            }
+        }
+        return file.delete();
+    }
